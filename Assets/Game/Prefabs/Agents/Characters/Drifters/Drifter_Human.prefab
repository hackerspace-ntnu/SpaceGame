--- !u!114 &6812814204369440184
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6110677241095528271}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc4e353a5d1e441e487401c86bbed068, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpaceGame.Gameplay.DialogInteraction
  dialogMode: 2
  dialogLines:
  - Hey there, traveler.
  - The desert gets colder at night.
  - Stay alert out here.
  predefinedRandomPool:
  - Came down in the same storm you did, near enough.
  - Walk where the sand is firm. You learn that fast or you don't.
  - I don't want trouble. Neither do you, out here.
  - My ship's under a dune somewhere east. I stopped looking for it.
  - The machines leave us be. Nothing on us worth the bullet.
  - Storm catches you in the open, get low and wait it out. Walking in it is how
    people go missing.
  - Drifting isn't a plan. It's what's left when the plan runs out.
  - Hurt one of us and you've hurt all of us. Otherwise, walk with us a while.
  globalDialogPool: {fileID: 0}
  branchingSteps: []
  loopDialogLines: 1
  allowRestartAfterEnd: 1
  finishCurrentLineOnInteractWhileTyping: 1
  popupDuration: 3
  interactionFocusDuration: 3
  restartFromBeginningAfterSeconds: 10
  useDelayBetweenDialogues: 1
  dialogueDelaySeconds: 1.5
  voiceId: 401
  voiceSound:
    Guid:
      Data1: 0
      Data2: 0
      Data3: 0
      Data4: 0
    Path: 
