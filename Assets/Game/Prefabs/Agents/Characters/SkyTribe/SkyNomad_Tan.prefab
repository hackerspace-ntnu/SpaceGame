  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpaceGame.Gameplay.DialogInteraction
  dialogMode: 2
  dialogLines:
  - Hey there, traveler.
  - The desert gets colder at night.
  - Stay alert out here.
  predefinedRandomPool:
  - The wind turned east this morning. Good day to fly.
  - You walk everywhere? Down here? Brave.
  - The city keeps its lights on for anyone who can reach it.
  - We trade high and sell low. Literally.
  - Mind the updraft off the dunes.
  - The freighters never land for long.
  - Half my hull is patches. The other half is hope.
  - Rust holds better than you'd think, a mile up.
  globalDialogPool: {fileID: 0}
  branchingSteps: []
  loopDialogLines: 1
  allowRestartAfterEnd: 1
  finishCurrentLineOnInteractWhileTyping: 1
  popupDuration: 3
  interactionFocusDuration: 3
