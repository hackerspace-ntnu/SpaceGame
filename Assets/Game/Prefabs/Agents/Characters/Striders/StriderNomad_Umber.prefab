  m_Script: {fileID: 11500000, guid: fc4e353a5d1e441e487401c86bbed068, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpaceGame.Gameplay.DialogInteraction
  dialogMode: 2
  dialogLines:
  - Hey there, traveler.
  - The desert gets colder at night.
  - Stay alert out here.
  predefinedRandomPool:
  - Mind the legs. They don't stop for anyone.
  - Everything out here is parts, if you look long enough.
  - We were walking before your ship fell. We'll be walking after.
  - Bring us scrap and we'll talk.
  - The houses carry us. We carry the houses. Fair trade.
  - Hear that grinding? That's the crawlers eating a hill.
  - Don't touch the rig. It bites.
  - Rust is just the metal remembering where it came from.
  globalDialogPool: {fileID: 0}
  branchingSteps: []
  loopDialogLines: 1
  allowRestartAfterEnd: 1
  finishCurrentLineOnInteractWhileTyping: 1
  popupDuration: 3
  interactionFocusDuration: 3
  restartFromBeginningAfterSeconds: 10
  useDelayBetweenDialogues: 1
  dialogueDelaySeconds: 1.5
  voiceId: 401
