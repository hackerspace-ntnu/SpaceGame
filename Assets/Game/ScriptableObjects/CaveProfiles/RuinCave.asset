  m_Name: RuinCave
  m_EditorClassIdentifier: Assembly-CSharp::CaveProfile
  description: Faithful recreation of the Ruin Cave cave generation parameters captured
    from the pre-refactor inline settings in the original scene. All new shape modifiers
    (cathedrals/slot canyons/shafts), the noise-type selector, and mesh smoothing
    are left at their defaults so this profile produces the same geometry the legacy
    code did.
  shape:
    seed: 0
    halfExtents: {x: 60, y: 35, z: 60}
    voxelSize: 1.5
    boundsPadding: 2
    roomCount: 40
    roomRadius: {x: 5, y: 9}
    bigRoomChance: 0.25
    maxCorridorLength: 40
    minConnectionsPerRoom: 2
    extraConnectionRatio: 0.25
    corridorRadius: {x: 1.4, y: 3}
    wideCorridorChance: 0.3
    verticalRange: 50
    verticalWalkBias: 0.245
    perRoomVerticalJitter: 4
    maxCorridorSlope: 0.6
    noiseType: 0
    noiseAmplitude: 1.4
    noiseFrequency: 0.08
    domainWarpStrength: 2.5
    smoothUnionRadius: 1.8
    enableCathedralChambers: 0
    cathedralCeilingLift: 10
    enableSlotCanyons: 0
    slotCanyonChance: 0.3
    slotCanyonHeightStretch: 2.5
    enableVerticalShafts: 0
    verticalShaftChance: 0.25
    verticalShaftMinDrop: 8
    verticalShaftRadius: 2.5
    flattenFloors: 1
    floorFlattenDepth: 1.5
    floorFlattenStrength: 0.65
    floorSlopeAmount: 0.18
    floorRoughness: 0.55
    floorRoughnessFrequency: 0.35
    floorClampY: -16
    use32BitIndices: 1
    flatShade: 0
    recalculateTangents: 0
    smoothingIterations: 3
    smoothingStrength: 0.5
    smoothingPreserveVolume: 1
    useGradientNormals: 1
    gradientEpsilon: 0.75
    bakeNavMeshOnGenerate: 1
  decoration:
    enabled: 1
    floorCeilingThreshold: 0.7
    globalInstanceCap: 4000
