--- !u!114 &1552731644144407853
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6320590716706008551}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc4e353a5d1e441e487401c86bbed068, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpaceGame.Gameplay.DialogInteraction
  dialogMode: 2
  dialogLines:
  - Hey there, traveler.
  - The desert gets colder at night.
  - Stay alert out here.
  predefinedRandomPool:
  - Shh. Hear that? No? Ears like these, you hear everything out here.
  - I heard your ship come down. Three dunes over. Very loud.
  - The machines hum before they come. I hear them long before you'd see them. We
    walk the other way.
  - Don't sneak up on me. You can't. But don't try.
  - Everyone asks about the ears. Nobody asks about the feet.
  - The wind talks at night. Mostly nonsense. Sometimes where the water is.
  - We don't fight. But start something and I'll hear it first. So will the others.
  globalDialogPool: {fileID: 0}
  branchingSteps: []
  loopDialogLines: 1
  allowRestartAfterEnd: 1
  finishCurrentLineOnInteractWhileTyping: 1
  popupDuration: 3
  interactionFocusDuration: 3
  restartFromBeginningAfterSeconds: 10
  useDelayBetweenDialogues: 1
  dialogueDelaySeconds: 1.5
  voiceSound:
    Guid:
      Data1: 0
      Data2: 0
      Data3: 0
      Data4: 0
    Path: 
