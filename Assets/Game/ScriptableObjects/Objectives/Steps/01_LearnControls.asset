  m_Script: {fileID: 11500000, guid: 769b08be6f3979a4ba2541f38456a57e, type: 3}
  m_Name: 01_LearnControls
  m_EditorClassIdentifier: Assembly-CSharp::SpaceGame.Gameplay.Objectives.LearnControlsStep
  id: learn-controls
  title: 'Get your legs under you'
  briefing:
  - 'Crew, do you read? Hull breach, main drive dead, but the cabin held. You''re alive.'
  - 'Unstrap and walk it off. Run, jump, crouch. I need to know the suits still work.'
  lookAtFocus: 0
  lessons:
  - control: 1
    keys: WASD
    action: move
  - control: 2
    keys: Shift
    action: sprint while moving
  - control: 4
    keys: Space
    action: jump
  - control: 8
    keys: C
    action: crouch
  moveThreshold: 0.5
  waitingForCrew: Waiting for the rest of the crew
  doneOpacity: 0.4
