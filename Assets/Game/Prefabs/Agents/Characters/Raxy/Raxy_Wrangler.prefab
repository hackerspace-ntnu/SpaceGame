  site: {fileID: 11400000, guid: 5da55564e22fa42bcb1b248621c35abd, type: 2}
  arriveRadius: 1.5
  greetRadius: 14
  focusSeconds: 4
  callOut: Hey, spacer! Ever sat an esko? Come talk to me.
  callRadius: 14
  offer: Name's Tovak. I break eskos for the town, and I'm short a pair of hands.
    Come on, I'll show you.
  afterwards:
  - Not bad for somebody who fell out of the sky.
  - The esko's yours to ride whenever you like. Bring her back fed.
