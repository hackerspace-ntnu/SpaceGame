  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc4e353a5d1e441e487401c86bbed068, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpaceGame.Gameplay.DialogInteraction
  dialogMode: 2
  dialogLines:
  - Hey there, traveler.
  - The desert gets colder at night.
  - Stay alert out here.
  predefinedRandomPool:
  - Your suit is loud. Everything out here hears it.
  - We were here before the wind changed.
  - Pass. I have no quarrel with you.
  - The sand remembers every ship that fell. It is patient about it.
  - You count days. We count storms. Fewer numbers.
  - The machines walk the same roads, again and again. We walk around them.
  - Water hides under stone, never under a dune. Remember that and you will live.
  globalDialogPool: {fileID: 0}
  branchingSteps: []
  loopDialogLines: 1
  allowRestartAfterEnd: 1
  finishCurrentLineOnInteractWhileTyping: 1
  popupDuration: 3
  interactionFocusDuration: 3
  restartFromBeginningAfterSeconds: 10
  useDelayBetweenDialogues: 1
  dialogueDelaySeconds: 1.5
  voiceId: 401
  voiceSound:
    Guid:
      Data1: 0
      Data2: 0
      Data3: 0
      Data4: 0
    Path: 
