  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpaceGame.Agents.AggressionTelegraphModule
  priority: 12
  active: 1
  warningLines:
  - Easy. We're not armed.
  - Point that somewhere else, friend.
  - We don't want a fight.
  lastWarningLines:
  - Lower it. I won't ask again.
  - Keep pointing that and we settle this.
  - Put it down, or we put you down.
  provokedLines:
  - You started this!
  - All right. You wanted a fight.
  - Drifters! On me!
  drawnAction: {fileID: 0}
  waryAction: {fileID: 11400000, guid: d9403d33a047405d91dc92050ffee8a9, type: 2}
