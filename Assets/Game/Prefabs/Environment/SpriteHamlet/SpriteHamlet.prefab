  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c37df95b98830d499e81f2f52ff41be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpaceGame.Gameplay.Objectives.QuestDialog
  entries:
  - window:
      chain: {fileID: 11400000, guid: 2d36ee478c712814192c88b71ceaeeda, type: 2}
      from: 
      until: favour-well-burn
    lines:
    - The witch's spores have choked our well. Nothing we do shifts them.
    - They only fear fire, and we have none.
    offerChain: 1
    question: Will you burn them out?
    yesLabel: I'll burn them
    noLabel: Not now
    acceptedLine: Mind the water, it's all we have!
    declinedLine: Another time, then.
  - window:
      chain: {fileID: 11400000, guid: 2d36ee478c712814192c88b71ceaeeda, type: 2}
      from: favour-well-burn
      until: '#complete'
    lines:
    - Fire, traveller. Only fire will do.
    offerChain: 0
    question: 
    yesLabel: 
    noLabel: 
    acceptedLine: 
    declinedLine: 
  - window:
      chain: {fileID: 11400000, guid: 2d36ee478c712814192c88b71ceaeeda, type: 2}
      from: '#complete'
      until: 
    lines:
    - Clear water again! The whole hamlet thanks you.
    offerChain: 0
    question: 
    yesLabel: 
    noLabel: 
    acceptedLine: 
    declinedLine: 
