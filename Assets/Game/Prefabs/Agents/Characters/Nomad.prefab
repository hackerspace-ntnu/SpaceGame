  m_Script: {fileID: 11500000, guid: fc4e353a5d1e441e487401c86bbed068, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpaceGame.Gameplay.DialogInteraction
  dialogMode: 2
  dialogLines:
  - Hey there, traveler.
  - The desert gets colder at night.
  - Stay alert out here.
  predefinedRandomPool:
  - Sand's been restless since the storm.
  - You're the first face I've seen in a week.
  - Careful past the ridge. Something out there hums at night.
  - Water first. Questions later.
  - I trade in scrap, not promises.
  - The old relay still sings, if you know where to listen.
  - Keep your visor sealed after dark.
  - Every wreck out here was somebody's ride home.
  globalDialogPool: {fileID: 0}
  branchingSteps: []
  loopDialogLines: 1
  allowRestartAfterEnd: 1
  finishCurrentLineOnInteractWhileTyping: 1
  popupDuration: 3
  interactionFocusDuration: 3
  restartFromBeginningAfterSeconds: 10
  useDelayBetweenDialogues: 1
  dialogueDelaySeconds: 1.5
