  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpaceGame.Gameplay.Objectives.QuestDialog
  entries:
  - window:
      chain: {fileID: 11400000, guid: 121bc16596a24234484fedfee26edb6d, type: 2}
      from: 
      until: favour-basket-deliver
    lines:
    - I climbed the old stump to pick shelf-fungus and left my acorn basket at the
      very top.
    - My legs won't take me up there twice.
    offerChain: 1
    question: Could you fetch it down for me?
    yesLabel: I'll get it
    noLabel: Not now
    acceptedLine: Oh, thank you! Just put it down by me.
    declinedLine: Another time, then.
  - window:
      chain: {fileID: 11400000, guid: 121bc16596a24234484fedfee26edb6d, type: 2}
      from: favour-basket-deliver
      until: '#complete'
    lines:
    - It's right at the top. Up the fungus steps, if you can.
    offerChain: 0
    question: 
    yesLabel: 
    noLabel: 
    acceptedLine: 
    declinedLine: 
  - window:
      chain: {fileID: 11400000, guid: 121bc16596a24234484fedfee26edb6d, type: 2}
      from: '#complete'
      until: 
    lines:
    - Every acorn still in it. You're a kind one.
    offerChain: 0
    question: 
    yesLabel: 
    noLabel: 
    acceptedLine: 
    declinedLine: 
