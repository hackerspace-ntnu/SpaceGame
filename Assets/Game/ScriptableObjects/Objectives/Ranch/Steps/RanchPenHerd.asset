  m_Script: {fileID: 11500000, guid: 4b894e7ab046544f08b6d6c1541fc583, type: 3}
  m_Name: RanchPenHerd
  m_EditorClassIdentifier: Assembly-CSharp::SpaceGame.World.PenHerdStep
  id: ranch-pen-herd
  title: Pen the wild eskos
  briefing:
  - There they are. Here, a rope each.
  - Hold the button to swing the loop, let go to throw it.
  - 'Rope them from the saddle: she''ll take the strain. On foot, one of these will
    drag you halfway to the dunes.'
  - Tow them back into the corral, let go once they're inside, and shut the gate.
  lookAtFocus: 0
