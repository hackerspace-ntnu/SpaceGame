{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest"]
    },
    "unityMCP": {
      "type": "http",
      "url": "http://localhost:8082/mcp"
    },
    "blender": {
      "command": "uvx",
      "args": [
        "blender-mcp"
      ],
      "env": {
        "DISABLE_TELEMETRY": "false"
      }
    }
  }
}
