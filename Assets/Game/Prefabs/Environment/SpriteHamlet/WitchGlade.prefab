MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5808612835006360596}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 999052d087a29ed42b10696942f07a4c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpaceGame.Presentation.DialogueCutscene
  speakerActorId: witch-morwen
  speakerName: MORWEN CROOKHAT
  lines:
  - Ohh, it has been a long time since I have seen you creatures!
  - Your herbs have granted me many extra years, and I have been ever so grateful.
  - "Yes \u2014 the trader with the crooked hat. You sold them to me yourselves,
    remember?"
  - But now you know my secret, and you know where I live.
  - No one should have that. I must be rid of you.
  secondsPerLine: 4
  gapSeconds: 0.3
  lookHeight: 2.4
  speakerWait: 3
  blendInDuration: 0.6
  blendOutDuration: 0.6
