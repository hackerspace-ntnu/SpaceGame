--- !u!114 &1883238364263445602
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4375941295063180595}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc4e353a5d1e441e487401c86bbed068, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpaceGame.Gameplay.DialogInteraction
  dialogMode: 2
  dialogLines:
  - Hey there, traveler.
  - The desert gets colder at night.
  - Stay alert out here.
  predefinedRandomPool:
  - Name's Gary. Just Gary. The others tried to give me a better one.
  - Ever lick the dew off a hull at sunrise? Best drink on the planet.
  - I collect bolts. Not for anything. I just like how they sound in the bag.
  - Storm's coming. I can feel it in my eyes.
  - The others walk quiet. I walk loud. Nothing's eaten me yet.
  - Find anything shiny, I'm not saying give it to me. I'm saying I'd look after
    it.
  - You're from the sky too? Everyone's from the sky. Well. Nearly everyone.
  globalDialogPool: {fileID: 0}
  branchingSteps: []
  loopDialogLines: 1
  allowRestartAfterEnd: 1
  finishCurrentLineOnInteractWhileTyping: 1
  popupDuration: 3
  interactionFocusDuration: 3
  restartFromBeginningAfterSeconds: 10
  useDelayBetweenDialogues: 1
  dialogueDelaySeconds: 1.5
  voiceId: 401
  voiceSound:
    Guid:
      Data1: 0
      Data2: 0
      Data3: 0
      Data4: 0
    Path: 
